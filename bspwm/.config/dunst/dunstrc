# Notification pop-ups for the bspwm session (Cinnamon shows its own). Gruvbox dark hard, like the bar.
[global]
    font = Ubuntu 10
    origin = top-right
    offset = 12x46
    width = 320
    frame_width = 2
    frame_color = "#87bd89"
    corner_radius = 10
    padding = 10
    horizontal_padding = 12
    icon_theme = Gruvbox-Tan
    max_icon_size = 32

[urgency_low]
    background = "#1d2021"
    foreground = "#d5c4a1"
    timeout = 4

[urgency_normal]
    background = "#1d2021"
    foreground = "#d5c4a1"
    timeout = 6

[urgency_critical]
    background = "#1d2021"
    foreground = "#d5c4a1"
    frame_color = "#fb4934"
    timeout = 0
