#!/usr/bin/python3
# Drop-down volume slider, opened by clicking the volume section of polybar.
# Opens under the mouse, just below the bar. Drag or scroll the slider; click away or press Esc to close.
# Clicking the volume section again while it's open closes it.
import os
import re
import signal
import subprocess
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk

STEP = 5             # % per scroll notch or arrow key
SLIDER_HEIGHT = 160  # px
BAR_HEIGHT = 34      # polybar's height including its border; the slider opens just below it
CSS = b"""
#volume-popup { background-color: #1d2021; border: 2px solid #87bd89; border-radius: 10px; }
#volume-popup scale trough { background-color: #504945; }
#volume-popup scale highlight { background-color: #fe8019; }
#volume-popup label { color: #d5c4a1; }
"""
SINK = "@DEFAULT_SINK@"
# When the slider closes because you clicked the bar, that same click would open it again straight away.
# Remembering when it last closed lets that click just close it.
CLOSED_AT = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "volume-popup.closed")


def pactl(*args):
    return subprocess.run(["pactl", *args], capture_output=True, text=True).stdout


def get_volume():
    match = re.search(r"(\d+)%", pactl("get-sink-volume", SINK))
    return int(match.group(1)) if match else 0


def close(*_):
    with open(CLOSED_AT, "w") as f:
        f.write(str(time.time()))
    Gtk.main_quit()


def on_slide(scale):
    volume = int(scale.get_value())
    pactl("set-sink-mute", SINK, "0")  # moving the slider unmutes
    pactl("set-sink-volume", SINK, f"{volume}%")
    label.set_text(f"{volume}%")


try:
    if time.time() - float(open(CLOSED_AT).read()) < 0.4:
        raise SystemExit
except (OSError, ValueError):
    pass

# Already open? Then this click closes it.
PID_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "volume-popup.pid")
try:
    pid = int(open(PID_FILE).read())
    if "volume-popup" in open(f"/proc/{pid}/cmdline").read():
        os.kill(pid, signal.SIGTERM)
        raise SystemExit
except (OSError, ValueError):
    pass
with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

style = Gtk.CssProvider()
style.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

popup = Gtk.Window(name="volume-popup", decorated=False, resizable=False, skip_taskbar_hint=True, skip_pager_hint=True)
popup.set_type_hint(Gdk.WindowTypeHint.UTILITY)
popup.set_keep_above(True)
visual = popup.get_screen().get_rgba_visual()
if visual:  # see-through corners, so the rounded border shows
    popup.set_visual(visual)

volume = get_volume()
scale = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, inverted=True, draw_value=False)
scale.set_range(0, 100)
scale.set_increments(STEP, STEP * 2)
scale.set_size_request(-1, SLIDER_HEIGHT)
scale.set_value(volume)
scale.connect("value-changed", on_slide)
label = Gtk.Label(label=f"{volume}%")

box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12)
box.pack_start(scale, True, True, 0)
box.pack_start(label, False, False, 0)
popup.add(box)

popup.connect("focus-out-event", close)
popup.connect("key-press-event", lambda _w, e: e.keyval == Gdk.KEY_Escape and close())
popup.connect("destroy", Gtk.main_quit)
popup.show_all()

# Centre it under the mouse, just below the bar
_screen, x, _y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()
width, _height = popup.get_size()
popup.move(x - width // 2, BAR_HEIGHT + 6)
popup.present()
scale.grab_focus()
Gtk.main()
