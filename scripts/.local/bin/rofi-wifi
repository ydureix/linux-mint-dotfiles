#!/usr/bin/python3
# Wi-Fi drop-down, opened by clicking the Wi-Fi icon on polybar. Opens under the mouse, just below the bar,
# in the same look as the volume slider (~/.local/bin/volume-popup).
# Pick a network to connect (asks for the password the first time), or turn Wi-Fi on/off from the top row.
# The network you're on is highlighted. Type to filter; Esc or a click outside closes it.
import re
import subprocess

from Xlib import display

BAR_HEIGHT = 34  # polybar's height including its border; the drop-down opens just below it
SIGNAL = ["\U000F091F", "\U000F0922", "\U000F0925", "\U000F0928"]  # weak .. strong, same icons as the bar
WIFI_ON, WIFI_OFF, LOCK = "\U000F05A9", "\U000F05AA", "\U000F033E"


def dropdown(*args, lines=10):
    """rofi -dmenu styled as a drop-down: centred under the mouse, dark with the bar's rounded green border."""
    x = display.Display().screen().root.query_pointer().root_x
    theme = ("* {font: \"Ubuntu 11\";} "
             f"window {{location: north west; anchor: north; x-offset: {x}px; y-offset: {BAR_HEIGHT + 6}px; "
             "width: 320px; padding: 8px; background-color: #1d2021; border: 2px; border-color: #87bd89; "
             "border-radius: 10px;} "
             f"mainbox {{children: [listview];}} listview {{columns: 1; lines: {lines}; padding: 0; spacing: 2px; "
             "fixed-height: false; scrollbar: false;} element {orientation: horizontal; padding: 6px 8px;} "
             "element-text {horizontal-align: 0;}")
    return ["rofi", "-dmenu", "-i", "-theme", "window-grid", "-theme-str", theme, *args]


def nmcli(*args):
    return subprocess.run(["nmcli", *args], capture_output=True, text=True)


def fields(line):
    """Split one line of nmcli -t output (colons inside values come escaped as \\:)."""
    return [f.replace("\\:", ":") for f in re.split(r"(?<!\\):", line)]


def notify(title, body=""):
    subprocess.run(["notify-send", "-i", "network-wireless", title, body])


def networks():
    """Nearby networks, strongest first, one row per name: (ssid, signal, security, connected)."""
    found = {}
    # Show the networks NetworkManager already knows about straight away (waiting for a fresh scan takes ~5 s),
    # and start a scan in the background so the list is fresher next time.
    subprocess.Popen(["nmcli", "device", "wifi", "rescan"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for line in nmcli("-t", "-f", "IN-USE,SIGNAL,SECURITY,SSID", "device", "wifi", "list", "--rescan", "no").stdout.splitlines():
        in_use, signal, security, ssid = fields(line)
        if not ssid:  # hidden network
            continue
        row = (ssid, int(signal or 0), security, in_use == "*")
        if ssid not in found or row[3] or (row[1] > found[ssid][1] and not found[ssid][3]):
            found[ssid] = row
    return sorted(found.values(), key=lambda n: (not n[3], -n[1]))


def connect(ssid, security):
    saved = {fields(l)[0] for l in nmcli("-t", "-f", "NAME,TYPE", "connection", "show").stdout.splitlines()
             if fields(l)[1] == "802-11-wireless"}
    if ssid in saved:
        result = nmcli("connection", "up", "id", ssid)
    elif security:
        ask = dropdown("-password", "-p", f"Password for {ssid}", lines=0)
        ask[ask.index("-theme-str") + 1] += (" mainbox {children: [inputbar];}"
                                             " inputbar {children: [prompt, textbox-prompt-sep, entry];}")
        password = subprocess.run(ask, input="", capture_output=True, text=True).stdout.strip()
        if not password:
            return
        result = nmcli("device", "wifi", "connect", ssid, "password", password)
    else:
        result = nmcli("device", "wifi", "connect", ssid)
    if result.returncode == 0:
        notify(f"Connected to {ssid}")
    else:
        notify(f"Couldn't connect to {ssid}", result.stderr.strip())


wifi_on = nmcli("radio", "wifi").stdout.strip() == "enabled"
nets = networks() if wifi_on else []
rows = [f"{WIFI_OFF}   Turn Wi-Fi off" if wifi_on else f"{WIFI_ON}   Turn Wi-Fi on"]
rows += [f"{SIGNAL[min(3, signal // 25)]}   {ssid}" + (f"   {LOCK}" if security else "") for ssid, signal, security, _ in nets]
active = [str(i + 1) for i, n in enumerate(nets) if n[3]]

# Start on the first network, not "Turn Wi-Fi off", so a stray Enter doesn't cut the connection
result = subprocess.run(dropdown("-no-custom", "-format", "i", "-selected-row", str(min(1, len(rows) - 1)),
                                 lines=min(len(rows), 10))
                        + (["-a", active[0]] if active else []),
                        input="\n".join(rows) + "\n", capture_output=True, text=True)
if result.returncode != 0 or not result.stdout.strip().isdigit():
    raise SystemExit
choice = int(result.stdout)
if choice == 0:
    nmcli("radio", "wifi", "off" if wifi_on else "on")
else:
    ssid, _, security, connected = nets[choice - 1]
    if not connected:
        connect(ssid, security)
