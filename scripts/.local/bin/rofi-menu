#!/usr/bin/python3
# Centred rofi app menu (Super+Tab). Look: ~/.config/rofi/themes/window-grid.rasi.
# Log out / Sleep / Power off are buttons on polybar instead.
# Super+Tab again, Esc, or a click outside closes it.
import subprocess

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio

ROFI = ["rofi", "-icon-theme", "Gruvbox-Tan"]


def icon_name(app):
    icon = app.get_icon()
    if isinstance(icon, Gio.ThemedIcon):
        return icon.get_names()[0]
    return icon.to_string() if icon else "application-x-executable"


apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()),
              key=lambda a: a.get_display_name().lower())
rows = "".join(f"{a.get_display_name()}\0icon\x1f{icon_name(a)}\n" for a in apps)

result = subprocess.run(
    ROFI + ["-dmenu", "-i", "-p", "Apps", "-show-icons", "-no-custom", "-format", "i",
            "-theme", "window-grid", "-kb-cancel", "Escape,Super+Tab"],
    input=rows, capture_output=True, text=True)

if result.returncode == 0 and result.stdout.strip().isdigit():
    apps[int(result.stdout)].launch([], None)
